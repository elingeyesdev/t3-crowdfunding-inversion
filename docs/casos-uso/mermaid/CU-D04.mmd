%% CU-D04 · Donar a una campaña
flowchart TD
  N0(["Inicio"])
  N1["1 · Donador: Abre la ficha e introduce un monto permitido."]
  N0 --> N1
  N2{"A3 · ¿No hay sesión o la campaña no admite aportes?"}
  A2["A3 · Iniciar Sesión para Donar abre el acceso; una campaña propia, cerrada o vencida no habilita el aporte.<br/>Continuidad: Continuar en CU-C02 si falta sesión; en los demás casos terminar."]
  N2 -->|Sí| A2
  N1 --> N2
  N3["1 · UniFundme: Actualiza el formulario y el botón Donar Bs. [monto]."]
  N2 -->|No| N3
  N4["2 · Donador: Pulsa Donar Bs. [monto]."]
  N3 --> N4
  N5["2 · UniFundme: Abre Confirmar Aporte con campaña, monto y recompensa seleccionada si existe."]
  N4 --> N5
  N6["3 · Donador: Confirma el aporte."]
  N5 --> N6
  N7{"A1 · ¿Cancela la confirmación?"}
  A7["A1 · No registra el aporte ni descuenta saldo.<br/>Continuidad: Terminar o volver al paso 1."]
  N7 -->|Sí| A7
  N6 --> N7
  N8{"A2 · ¿Cambió el saldo, estado, límite, cupo o validez de la recompensa?"}
  A8["A2 · Rechaza el aporte sin descuento parcial de saldo.<br/>Continuidad: Revisar condiciones y volver al paso 1 o terminar."]
  N8 -->|Sí| A8
  N7 -->|No| N8
  N9["3 · UniFundme: Valida saldo, estado, fecha, límites y recompensa; registra el aporte y actualiza saldo y recaudación en una sola operación correcta."]
  N8 -->|No| N9
  N10["4 · Donador: Consulta la confirmación y su panel."]
  N9 --> N10
  N11["4 · UniFundme: Presenta el aporte registrado y permite continuar a sus comprobantes cuando corresponde."]
  N10 --> N11
  N12(["Fin del recorrido principal"])
  N11 --> N12
