%% CU-A05 · Revisar solicitudes KYC
flowchart TD
  N0(["Inicio"])
  N1["1 · Administrador: Abre Verificaciones KYC y pulsa Revisar."]
  N0 --> N1
  N2["1 · UniFundme: Presenta datos, documento de identidad y validación facial autorizados."]
  N1 --> N2
  N3["2 · Administrador: Consulta los archivos y la información presentada."]
