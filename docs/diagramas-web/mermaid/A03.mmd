%% A03 · Revisar, aprobar o rechazar campañas
%% Rol: Administrador
%% Entrada: Panel → Revisión de Campañas · /admin/campaigns/review
flowchart TD
  N0(["Inicio"])
  N0 --> N1
  N1["Buscar por título o emprendedor con Enter; recorrer las páginas de pendientes"]
  N1 --> N2
  N2["Abrir el detalle y examinar propuesta, propietario, documentos e historial"]
  N2 --> N3
  N3["Revisar documentos con A05 si es necesario"]
  N3 --> N4
  N4{"¿La campaña cumple los criterios de revisión?"}
  N4 -->|"Sí"| N5
  B4(["Escribir motivo, rechazar y notificar al emprendedor para corregir y reenviar"])
  N4 -->|"No"| B4
  N5["Pulsar Aprobar y completar la confirmación si se solicita"]
  N5 --> N6
  N6{"¿Se registró la aprobación?"}
  N6 -->|"Sí"| N7
  B6["Leer el error y volver a cargar la campaña antes de reintentar"]
  N6 -->|"No"| B6
  B6 --> N2
  N7["La campaña queda Aprobada; el emprendedor debe lanzarla en E05"]
  N7 --> N8
  N8(["Fin"])
