%% D01 · Crear o editar el perfil de donador
%% Rol: Donador
%% Entrada: Barra superior → Mi Perfil · /profile
flowchart TD
  N0(["Inicio"])
  N0 --> N1
  N1["Abrir Mi Perfil; si no existe, se propone completar el perfil"]
  N1 --> N2
  N2["Elegir Editar o una sección: datos básicos, fiscales, ubicación o preferencias"]
  N2 --> N3
  N3["Completar los datos y guardar"]
  N3 --> N4
  N4{"¿Se guardaron correctamente?"}
  N4 -->|"Sí"| N5
  B4["Corregir los campos indicados y volver a guardar"]
  N4 -->|"No"| B4
  B4 --> N3
  N5["Opcional: cambiar foto o portada con sus controles de imagen"]
  N5 --> N6
  N6["Consultar Información, Donaciones o Capital / Fondos del perfil"]
  N6 --> N7
  N7(["Fin"])
