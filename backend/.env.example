# Configuración del Servidor
PORT=3000
CORS_ORIGIN=*

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1234
DB_NAME=crowdfunding
DB_SSL=false

# Configuración de Seguridad y JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Configuración del Asistente de IA (DeepSeek)
# Si no se define, el backend iniciará correctamente pero las funciones de IA devolverán un mensaje indicando que no están disponibles.
DEEPSEEK_API_KEY=tu_api_key_aqui
